[node name="SegmentDemo" type="Node2D" unique_id=1657372274]

[node name="Instructions" type="Label" parent="." unique_id=82462718]
offset_left = 35.0
offset_top = 25.0
offset_right = 35.0
offset_bottom = 25.0
text = "1. Install and open the demo.
This demo opens with the plugin enabled.
2. Choose and preview.
Select AnimationPlayer in the Scene tree.
In Segment Transfer, choose source and destination.
Check Left:rotation, Right:rotation and Center:rotation.
Leave Center:position:y unchecked. Set Start = End = 1 second.
Preview: 3 keys, 1 new track.
3. Transfer, inspect, then undo or save.
Click Transfer. Inspect destination in the native Animation timeline.
Use normal Undo/Redo, or save the scene."

