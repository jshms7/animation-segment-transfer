config_version=5

[application]
config/name="Animation Segment Transfer Demo"
run/main_scene="res://demo/demo.tscn"

[display]
window/size/viewport_width=900
window/size/viewport_height=540

[rendering]
renderer/rendering_method="gl_compatibility"
environment/defaults/default_clear_color=Color(0.055, 0.07, 0.1, 1)

[editor_plugins]
enabled=PackedStringArray("res://addons/animation_segment_transfer/plugin.cfg")
